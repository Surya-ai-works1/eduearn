# EduEarn Environment Variables - Template Configuration
# Copy this file to .env.local for local testing and configuration.

# ==============================================================================
# 💡 OFFLINE MOCK MODE
# If Supabase variables are left empty, the application automatically runs in 
# offline mock mode, allowing full functionality testing without backend setup.
# ==============================================================================

# Supabase Auth & Database (Required for live backend functionality)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Optional for live AI features, mocks used if omitted)
GEMINI_API_KEY=

# Local / Production App URL (Required for canonical site metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Toggle to disable/enable email verification requirement (default is false)
NEXT_PUBLIC_DISABLE_EMAIL_VERIFICATION=false

# Razorpay key (Optional for payment checkout simulators)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Brevo Transactional Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
